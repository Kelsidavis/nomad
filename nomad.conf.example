# NOMAD settings. Copy this file to nomad.conf (gitignored: everyone keeps their own) and fill it in.
# Shell syntax (KEY=value, no spaces around =): setup-pi.sh and deploy.sh source it, and setup-pi.sh installs it on
# the Pi as /etc/nomad.conf, where the services read it.

# Where deploy.sh sends your working copy: user@host of the Pi.
PI_HOST=pi@raspberrypi.local

# The head unit's name: its Bluetooth name, and the word that starts a voice command ("Truck, navigate home").
NOMAD_NAME=Truck

# lat,lon for weather and satellite passes before there's a GPS fix or a home set in Settings. Optional.
HEADUNIT_HOME=

# Serial of the USB GPS (a CP210x bridge) for its udev rule. Empty: setup-pi.sh uses the one plugged in.
GPS_SERIAL=

# headunit/tools/plex_music.py: copy a Plex music library for the car (lossless becomes Opus).
PLEX_SERVER=http://plex.local:32400
PLEX_SECTION=
PLEX_TOKEN_FILE=~/.config/nomad/plex.token
MUSIC_OUT=~/CarMusic

# News screen's starting feeds (Name|url, comma separated); edit them on the screen after that
#NEWS_FEEDS=NPR|https://feeds.npr.org/1001/rss.xml, BBC World|https://feeds.bbci.co.uk/news/world/rss.xml

# OBD-II adapter: auto (USB, then paired Bluetooth), /dev/ttyUSB1, bt:AA:BB:CC:DD:EE:FF, tcp:192.168.0.10:35000, or off
#OBD_DEVICE=auto

# LoRa: the Meshtastic radio: auto (a USB board), /dev/ttyACM0, tcp:<host> (a node on Wi-Fi), or off
#MESH_DEVICE=auto

# Weekly fuel price averages: a free key from https://www.eia.gov/opendata/register.php
#EIA_API_KEY=

# Bluetooth amp or speaker to keep connected and use as the output (its address: bluetoothctl devices); empty = built-in audio
#BT_AUDIO=AA:BB:CC:DD:EE:FF

# Fuel planning on routes: the tank's size in US gallons (with the OBD fuel gauge it gives the range), and the
# percent of the tank to keep in reserve (default 10)
#FUEL_TANK_GAL=26
#FUEL_RESERVE_PCT=10
