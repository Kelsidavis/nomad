[Unit]
Description=Head unit UI backend (map, media, phone bridge) on 127.0.0.1:8800
After=network.target gpsd.service dashlink-adb.service
Wants=gpsd.service

[Service]
ExecStart=/usr/bin/python3 /opt/headunit/server.py
Restart=always
RestartSec=3
User=k
# wpctl (volume) and aplay (spoken directions) talk to the desktop user's PipeWire.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DASHLINK_DIR=/opt/dashlink
# NOMAD settings (setup-pi.sh copies nomad.conf here)
EnvironmentFile=-/etc/nomad.conf

[Install]
WantedBy=multi-user.target
