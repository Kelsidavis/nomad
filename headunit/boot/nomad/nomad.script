// NOMAD boot screen: the logo on black, breathing gently while the Pi starts.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
logo = Image("logo.png");
scale = Math.Min(1, Window.GetWidth() * 0.8 / logo.GetWidth());
logo = logo.Scale(logo.GetWidth() * scale, logo.GetHeight() * scale);
sprite = Sprite(logo);
sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);
t = 0;
fun refresh() {
  t++;
  sprite.SetOpacity(0.72 + 0.28 * Math.Sin(t / 18));
}
Plymouth.SetRefreshFunction(refresh);
